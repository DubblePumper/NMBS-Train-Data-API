# NMBS API Configuration
# Replace this URL with the actual URL if it changes
NMBS_DATA_URL=https://www.belgiantrain.be/nl/3rd-party-services/mobility-service-providers/public-data/use-our-data

# Cloudflare Bypass Settings
# You may need to update these based on your browser
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/132.0.0.0 Safari/537.36 OPR/117.0.0.0
COOKIES_FILE=data/cookies.json

# Web API Settings
API_PORT=25580
API_HOST=0.0.0.0

# Proxy Settings (Pelican VPS)
PROXY_IP=
PROXY_PORT=

# Database credentials
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# API settings
DEBUG=false
LOG_LEVEL=INFO
ENABLE_CACHE=true

# Security and CORS
# Use '*' for all origins or comma-separated origins, e.g. https://myapp.example.com,https://admin.example.com
CORS_ORIGINS=*

# Optional token required for POST /api/update
# Can be sent using header: X-API-Token: <token>
# or Authorization: Bearer <token>
API_UPDATE_TOKEN=

# Service intervals
DATA_INTERVAL=60
SCRAPE_INTERVAL=86400
DATA_DIR=data