# NMBS API Configuration
# Official Belgian Mobility GTFS Schedule feed (NMBS-SNCB)
NMBS_DATA_URL=https://api-management-discovery-production.azure-api.net/api/gtfs/feed/nmbssncb/static

# Official Belgian Mobility GTFS-Realtime feeds (NMBS-SNCB)
NMBS_REALTIME_TRIP_UPDATES_URL=https://api-management-discovery-production.azure-api.net/api/gtfs/feed/nmbssncb/rt/trip-update
NMBS_REALTIME_SERVICE_ALERTS_URL=https://api-management-discovery-production.azure-api.net/api/gtfs/feed/nmbssncb/rt/alert

# Optional NeTEx EPIP export
NMBS_NETEX_ENABLED=false
NMBS_NETEX_URL=https://belgianmobility.blob.core.windows.net/epip-production/epip-nmbssncb-bmc-latest.xml

# Belgian Mobility developer portal subscription key for frequent requests
BM_API_KEY=
BM_API_KEY_HEADER=Ocp-Apim-Subscription-Key
NMBS_API_USER_AGENT=nmbs-train-data-api/0.2
NMBS_DOWNLOAD_TIMEOUT=60

# Web API Settings
API_PORT=25580
API_HOST=0.0.0.0

# Proxy Settings (Pelican VPS)
PROXY_IP=
PROXY_PORT=

# Database credentials
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# API settings
DEBUG=false
LOG_LEVEL=INFO
ENABLE_CACHE=true

# Security and CORS
# Use '*' for all origins or comma-separated origins, e.g. https://myapp.example.com,https://admin.example.com
CORS_ORIGINS=*

# Optional token required for POST /api/update
# Can be sent using header: X-API-Token: <token>
# or Authorization: Bearer <token>
API_UPDATE_TOKEN=

# Service intervals
DATA_INTERVAL=30
SCRAPE_INTERVAL=86400
PLANNING_INTERVAL=86400
NETEX_INTERVAL=86400
DATA_DIR=data
SNAPSHOT_ROOT=exports
